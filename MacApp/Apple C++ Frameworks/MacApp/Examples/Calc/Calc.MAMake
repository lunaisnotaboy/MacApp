"{SrcApp}UCalcColumns.h" ¶	{MacAppCPlusIntf} ¶	{BuildingBlocksCPlusIntf}"{ObjApp}UCalcColumns.cp.o" Ä ¶	"{SrcApp}UCalc.h" ¶	"{SrcApp}CalcUtilities.h" ¶	"{SrcApp}UCalcRows.h" ¶	"{SrcApp}UCalcCells.h" ¶	"{SrcApp}UCalcColumns.h" ¶	{MacAppCPlusIntf} ¶	{BuildingBlocksCPlusIntf}"{ObjApp}"MCalc.cp.o Ä ¶	"{SrcApp}"CalcUtilities.h ¶	"{SrcApp}"UCalc.h ¶	{MacAppCPlusIntf} ¶	{BuildingBlocksCPlusIntf}#---------------------------------------------------------------------------------------------------#	List resource files that the Rez file includes if you want to include#	more or less than the standard setOtherRsrcFiles = ¶	"{MAFrameworkObj}ResourceLib.rsrc" ¶	"{MAViewsObj}Printing.rsrc" ¶	"{ObjApp}CalcUtilities.rsrc"