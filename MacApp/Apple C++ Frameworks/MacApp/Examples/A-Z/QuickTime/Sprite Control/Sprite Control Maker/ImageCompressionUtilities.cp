//																					Peter Hoddie, Sean Allen// _____________________ Image Compression Utilities _____________________ ////#ifndef _ImageCompressionUtilities_#include "ImageCompressionUtilities.h"#endif#ifndef __COLORPICKER__	#include <ColorPicker.h>#endif#ifndef __RESOURCES__	#include <Resources.h>#endifpascal void extractStdPix( PixMap *src, Rect *srcRect, MatrixRecord *matrix, short mode, RgnHandle mask, PixMap *matte, Rect *matteRect, short flags );static OSErr compressTransparentRLEwithHitTesting( short resourceID, Handle compressedImage, RGBColor *keyColor );static ImageDescriptionHandle createImageDescription( CodecType cType, PixMapHandle pixmap );static void DrawPictureNoDither(PicHandle pic, const Rect *bounds);static OSErr prepareFor16BitCompress(PicHandle *pic);typedef struct {	CGrafPort tempPort;	Handle data;	ImageDescriptionHandle idh;} extractPictRecord;#define kCompressDepth	16#define kCompressType	'rle '#define		BailIf(a, e) 		{if (a) 	{ err = e; goto bail; }}#define		BailOSErr(a) 		{if ((err = a) != noErr)	goto bail;}#define		BailMemErr(a)		{a; if ((err = MemError()) != noErr) goto bail;}// PICT to compressed image conversionOSErr ExtractCompressData( PicHandle thePict, Handle *dataOut, ImageDescriptionHandle *idh ){	OSErr				err = noErr;	extractPictRecord 	state;	CQDProcs 			procs;	GrafPtr 			savePort;	Rect 				bounds;	if ( dataOut )		*dataOut = nil;	if ( idh )		*idh = nil;	GetPort( &savePort );	OpenCPort( &state.tempPort );	SetStdCProcs( &procs );	procs.newProc1 = (UniversalProcPtr)NewStdPixProc(extractStdPix);	state.tempPort.grafProcs = &procs;	state.data = nil;	state.idh = nil;	SetPort( (GrafPtr)&state.tempPort );	HidePen();	bounds = (**thePict).picFrame;	DrawPicture(thePict, &bounds);	bail:	SetPort( savePort );	CloseCPort( &state.tempPort );	*dataOut	= state.data;	*idh		= state.idh;	return err;}pascal void extractStdPix( PixMap *src, Rect *srcRect, MatrixRecord *matrix, short mode, RgnHandle mask, PixMap *matte, Rect *matteRect, short flags ){#pragma unused(srcRect,matrix,mode,mask,matte,matteRect,flags)	extractPictRecord	*state;	GetPort( (GrafPtr *)&state );	if  ( state->idh == nil ) {		ImageDescriptionHandle	desc;		Ptr 					data;		long					bufferSize;		if ( GetCompressedPixMapInfo(src, &desc, &data, &bufferSize, nil, nil) == noErr ) {			state->idh = desc;			HandToHand( (Handle *)&state->idh );			PtrToHand( data, &state->data, bufferSize );		}	}}void MakePictTransparent( PicHandle pic, RGBColor *keyColor ){	OSErr					err;	CGrafPtr 				savePort;	GDHandle 				saveGD;	GWorldPtr 				gw = nil;	Rect 					bounds;	ImageSequence 			seq = 0;	ImageDescriptionHandle 	desc = nil;	Ptr 					data = 0;	long 					dataSize;	UInt8 					similarity;	PicHandle 				newPict = nil;	RGBColor 				saveBackColor;		GetGWorld( &savePort, &saveGD );	bounds = (**(PicHandle)pic).picFrame;	OffsetRect( &bounds, -bounds.left, -bounds.top );	err = NewGWorld( &gw, kCompressDepth, &bounds, nil, nil, useTempMem );	if (err)		err = NewGWorld( &gw, kCompressDepth, &bounds, nil, nil, 0 );	LockPixels( gw->portPixMap );	SetGWorld( gw, nil );	GetBackColor( &saveBackColor );	RGBBackColor( keyColor );		EraseRect( &bounds );	RGBBackColor( &saveBackColor );	BailMemErr( desc = (ImageDescriptionHandle)NewHandleClear( sizeof(ImageDescription) ) )//•	err = CompressSequenceBegin( &seq, gw->portPixMap, nil, &bounds, nil, kCompressDepth, kCompressType, 0, codecNormalQuality, codecNormalQuality, 2, nil, 0, desc );	err = CompressSequenceBegin( &seq, gw->portPixMap, nil, &bounds, nil, kCompressDepth, kCompressType, 0, codecLosslessQuality, codecLosslessQuality, 2, nil, 0, desc );	if (err) goto bail;	err = GetMaxCompressionSize( gw->portPixMap, &bounds, kCompressDepth, codecMaxQuality, kCompressType, 0, &dataSize );	if ( err ) goto bail;	BailMemErr( data = NewPtr( dataSize ) );	err = CompressSequenceFrame( seq, gw->portPixMap, &bounds, codecFlagUpdatePrevious, data, &dataSize, &similarity, nil );	if ( err ) goto bail;	DrawPictureNoDither( pic, &bounds );	err = CompressSequenceFrame( seq, gw->portPixMap, &bounds, codecFlagUpdatePrevious, data, &dataSize, &similarity, nil );	if ( err ) goto bail;	CDSequenceEnd( seq );	seq = 0;	newPict =  OpenPicture( &bounds );	err = DecompressImage( data, desc, gw->portPixMap, &bounds, &bounds, ditherCopy, nil );	ClosePicture();	if ( err ) goto bail;	SetHandleSize( (Handle)pic, 0 );	HandAndHand( (Handle)newPict, (Handle)pic );bail:	CDSequenceEnd( seq );	SetGWorld( savePort, saveGD );	if ( gw ) DisposeGWorld( gw );	DisposeHandle( (Handle)desc );	if ( data ) DisposePtr( data );	KillPicture( newPict );	return;}OSErr CompressPictAsTransparentRLE( void ){	OSErr 				err = noErr;	SFTypeList 			types;	StandardFileReply 	reply;	SFReply				sfReply;	Point				where = { 100, 100 };	RGBColor			inColor = { 65535, 65535, 65535 }, transparentColor;	FSSpec 				fileSpec;	short				sourceRefNum = 0, destRefNum = 0;	long				size;	Handle				picture = nil, pictureFileData = nil;	types[0] = 'PICT';	StandardGetFile( nil, 1, types, &reply );	if ( !reply.sfGood ) return noErr;	if ( GetColor( where, "\pPick Transparent Color", &inColor, &transparentColor ) ) {				BailOSErr( FSMakeFSSpec( reply.sfFile.vRefNum, reply.sfFile.parID, reply.sfFile.name, &fileSpec ) );		BailOSErr( FSpOpenDF( &fileSpec, fsRdPerm, &sourceRefNum ) );		BailOSErr( GetEOF( sourceRefNum, &size ) );		size -= 512;		BailMemErr( picture = NewHandle( size ) );		BailOSErr( SetFPos( sourceRefNum, fsFromStart, 512 ) );					HLock( picture );		BailOSErr( FSRead( sourceRefNum, &size, *picture ) );		HUnlock( picture );		// convert it to image data compressed by the animation compressor		MakePictTransparent( (PicHandle)picture, &transparentColor );		// save the file		SFPutFile( where, "\pEnter compressed file name:", "\ptransparent PICT", nil, &sfReply );		err = FSDelete( sfReply.fName, sfReply.vRefNum );		if ( err == fnfErr )	err = noErr;		if ( err ) 	goto bail;			BailOSErr( Create( sfReply.fName, sfReply.vRefNum, kAppleManufacturer, 'PICT' ) );		BailOSErr( FSOpen( sfReply.fName, sfReply.vRefNum, &destRefNum ) );		BailOSErr( SetFPos( destRefNum, fsFromStart, 0 ) );			BailMemErr( pictureFileData = NewHandleClear( 512 ) );		HandAndHand( picture, pictureFileData );		HLock( (Handle)pictureFileData );		size = GetHandleSize( pictureFileData );		BailOSErr( FSWrite( destRefNum, &size, *pictureFileData ) );	}bail:	if ( picture )					DisposeHandle( picture );	if ( pictureFileData )			DisposeHandle( pictureFileData );	if ( sourceRefNum )				FSClose( sourceRefNum );	if ( destRefNum )				FSClose( destRefNum );	return err;}OSErr CompressPICTResourcesAsTransparentRLE( Boolean withHitTesting ){	OSErr					err = noErr;	short 					inputRefNum, outputRefNum;	Handle					aPicture = nil;	SFTypeList 				types;	StandardFileReply 		reply;	Point					where = { 100, 100 };	RGBColor				inColor = { 65535, 65535, 65535 }, transparentColor;	SFReply					sfReply;	long					i, numPicts;	OSType					outputFileType, creatorType;	Handle					compressedPicture, idh;	CGrafPtr 				savePort;	GDHandle 				saveGD;	GetGWorld( &savePort, &saveGD );		// open input file		types[0] = 'rsrc';	types[1] = 'PICT';	StandardGetFile( nil, 2, types, &reply );	if ( !reply.sfGood ) return noErr;	if ( GetColor( where, "\pPick Transparent Color", &inColor, &transparentColor ) ) {		inputRefNum = HOpenResFile( reply.sfFile.vRefNum, reply.sfFile.parID, reply.sfFile.name, fsRdPerm );		if ( inputRefNum == -1 )	{ err = -1; goto bail; }			// create output file		SFPutFile( where, "\pEnter output file name:", "\ptransparent PICTs", nil, &sfReply );			SetVol( 0, sfReply.vRefNum );		err = FSDelete( sfReply.fName, sfReply.vRefNum );		if ( err == fnfErr )	err = noErr;		if ( err ) 	goto bail;			if (*(char *)0x17b & 2) {		// if caps lock key down create 'PICR'			outputFileType 	= 'PICT';			creatorType 	= 'BABL';		}		else {			outputFileType 	= 'rsrc';			creatorType 	= 'RSED';		}		err = Create( sfReply.fName, sfReply.vRefNum, creatorType, outputFileType );		if ( err ) 	goto bail;			CreateResFile( sfReply.fName );		if ( ( err = ResError() ) != noErr ) goto bail;				outputRefNum = OpenResFile( sfReply.fName );		if ( outputRefNum == -1 )	{ err = -1; goto bail; }   		UseResFile( inputRefNum );		numPicts = Count1Resources( 'PICT' );				for ( i = 1; i <= numPicts; i++ ) {			short	id;			ResType	type;			Str255	name;						UseResFile( inputRefNum );			aPicture = Get1IndResource( 'PICT', i );			GetResInfo( aPicture, &id, &type, name );			DetachResource( aPicture );			prepareFor16BitCompress((PicHandle *)&aPicture);			if ( withHitTesting ) {				if ( id < 1000 ) {					idh = NewHandle(0);					err = compressTransparentRLEwithHitTesting( id, idh, &transparentColor );				}			}			else {					MakePictTransparent( (PicHandle)aPicture, &transparentColor );				ExtractCompressData( (PicHandle)aPicture, &compressedPicture, &(ImageDescriptionHandle)idh );					BailMemErr( HandAndHand( compressedPicture, idh ) );			}			DisposeHandle( aPicture );			aPicture = nil;			if ( idh ) {				UseResFile( outputRefNum );					AddResource( idh, 'imag', id, name );				if ( ( err = ResError() ) != noErr ) goto bail;								ChangedResource( idh );				if ( ( err = ResError() ) != noErr ) goto bail;					WriteResource( idh );				if ( ( err = ResError() ) != noErr ) goto bail;							ReleaseResource( idh );				idh = nil;			}		}	}	bail:	SetGWorld( savePort, saveGD );	if ( outputRefNum )		CloseResFile( outputRefNum );	if ( inputRefNum )		CloseResFile( inputRefNum );	return err;}static OSErr compressTransparentRLEwithHitTesting( short resourceID, Handle compressedImage, RGBColor *keyColor ){	OSErr err;	PicHandle p;	GWorldPtr gwImage, gwMap, gwPrev;	Rect r;	ImageSequence seq;	ImageDescriptionHandle desc, gwDesc;	ImageSequenceDataSource mapSource;	long maxSize;	Ptr compressedData;	long compressedDataSize;	Boolean hit = false;	unsigned char sim;	p = GetPicture(resourceID);	r = (**p).picFrame;	OffsetRect(&r, -r.left, -r.top);	NewGWorld(&gwImage, 16, &r, nil, nil, 0);	NewGWorld(&gwPrev, 16, &r, nil, nil, 0);	NewGWorld(&gwMap, 8, &r, nil, nil, 0);	if (!gwMap || !gwImage || !gwPrev) return paramErr;	LockPixels(gwImage->portPixMap);	LockPixels(gwMap->portPixMap);	LockPixels(gwPrev->portPixMap);//	OffsetRect(&r, 40, 40);//	wPort = NewCWindow(nil, &r, "\pfoo", true, rDocProc, (WindowPtr)-1, false, 0);//	OffsetRect(&r, -40, -40);	SetGWorld(gwPrev, nil);	EraseRect(&gwPrev->portRect);	SetGWorld(gwImage, nil);	DrawPicture(p, &gwImage->portRect);	ReleaseResource((Handle)p);	p = GetPicture(resourceID + 900);	SetGWorld(gwMap, nil);	DrawPicture(p, &r);	ReleaseResource((Handle)p);//	SetGWorld((CGrafPtr)wPort, nil);	desc = (ImageDescriptionHandle)NewHandle(0);	gwDesc = createImageDescription('raw ', gwMap->portPixMap);	err = CompressSequenceBegin(&seq, gwPrev->portPixMap, nil, nil, nil, 16, 'rle ', anyCodec, codecNormalQuality, codecNormalQuality, 2, nil, 0, desc);	if (err) return err;	err = CDSequenceNewDataSource(seq, &mapSource, 'imap', 1, (Handle)gwDesc, nil, nil);	if (err) return err;	err = CDSequenceSetSourceData(mapSource, GetPixBaseAddr(gwMap->portPixMap), (**gwDesc).dataSize);	if (err) return err;	err = GetCSequenceMaxCompressionSize(seq, gwPrev->portPixMap, &maxSize);	if (err) return err;	compressedData = NewPtr(maxSize);	if (!compressedData) return MemError();	err = CompressSequenceFrame(seq, gwPrev->portPixMap, nil, 0, compressedData, &compressedDataSize, &sim, nil);	if (err) return err;	err = SetCSequencePrev(seq, gwPrev->portPixMap, nil);	if (err) return err;	err = CompressSequenceFrame(seq, gwImage->portPixMap, nil, 0, compressedData, &compressedDataSize, &sim, nil);	if (err) return err;	CDSequenceEnd(seq);	BailMemErr( SetHandleSize( compressedImage, 0 ) );		BailMemErr( HandAndHand( (Handle)desc, compressedImage ) );	BailMemErr( PtrAndHand( compressedData, compressedImage, compressedDataSize ) );	#if 0	err = DecompressSequenceBegin(&seq, desc, nil, nil, nil, nil, ditherCopy, nil, 0, 0, anyCodec);	if (err) return;	SetDSequenceFlags(seq, codecDSequenceAllowPartialFrames, codecDSequenceAllowPartialFrames );	ForeColor(redColor);	PaintRect(&qd.thePort->portRect);	ForeColor(blackColor);	DecompressSequenceFrame(seq, compressedData, 0, nil, nil);#endifbail:	CDSequenceEnd(seq);//	SetGWorld( savePort, saveGD );	if ( gwPrev ) 			DisposeGWorld( gwPrev );	if ( gwImage ) 			DisposeGWorld( gwImage );	if ( gwMap ) 			DisposeGWorld( gwMap );	if ( desc )				DisposeHandle( (Handle)desc );	if ( gwDesc )			DisposeHandle( (Handle)gwDesc );	if ( compressedData )	DisposePtr( compressedData );	return err;}static ImageDescriptionHandle createImageDescription( CodecType cType, PixMapHandle pixmap ){	ImageDescriptionHandle	desc = nil;		if ( ( desc = (ImageDescription **)NewHandleClear(sizeof(ImageDescription)) ) != nil ) {		ImageDescription 	*dp = *desc;		Rect				bounds = (**pixmap).bounds;		dp->idSize 			= sizeof(ImageDescription);		dp->cType 			= cType;			dp->spatialQuality 	= codecNormalQuality;		dp->width			= bounds.right - bounds.left;		dp->height 			= bounds.bottom - bounds.top;		dp->hRes 			= 72L << 16;		dp->vRes 			= 72L << 16;		dp->dataSize 		= ((**pixmap).rowBytes & 0x3fff) * dp->height;		dp->depth 			= (**pixmap).pixelSize;		dp->clutID 			= -1;				if ( SetImageDescriptionCTable( desc, (**pixmap).pmTable ) ) {			DisposeHandle( (Handle) desc );			desc = nil;		}	}	return desc;}pascal void noDitherBitsProc(const BitMap *srcBits, const Rect *srcRect, const Rect *dstRect, short mode, RgnHandle maskRgn);pascal void noDitherBitsProc(const BitMap *srcBits, const Rect *srcRect, const Rect *dstRect, short mode, RgnHandle maskRgn){	mode &= ~ditherCopy;	StdBits(srcBits, srcRect, dstRect, mode, maskRgn);}void DrawPictureNoDither(PicHandle pic, const Rect *bounds){			CQDProcs procs;	GrafPtr savePort;	CQDProcsPtr saveProcs;	GetPort(&savePort);	saveProcs = (CQDProcsPtr)savePort->grafProcs;	SetStdCProcs( &procs );	procs.bitsProc = (QDBitsUPP)noDitherBitsProc;	savePort->grafProcs = (QDProcs *)&procs;	DrawPicture(pic, bounds);	savePort->grafProcs = (QDProcs *)saveProcs;}#define kThreshold (255 - 16)OSErr prepareFor16BitCompress(PicHandle *pic){	OSErr err = noErr;	PicHandle newPicture = nil;	Rect r;	GWorldPtr gw = nil;	CGrafPtr savePort;	GDHandle saveGD;	short rowBytes;	Ptr baseAddr;	long w, h;	GetGWorld(&savePort, &saveGD);	r = (***pic).picFrame;	OffsetRect(&r, -r.left, -r.top);	err = NewGWorld(&gw, 32, &r, nil, nil, useTempMem);	if (err) {		err = NewGWorld(&gw, 32, &r, nil, nil, 0);		if (err) goto bail;	}	LockPixels(gw->portPixMap);	SetGWorld(gw, nil);	EraseRect(&r);	DrawPicture(*pic, &r);	baseAddr = GetPixBaseAddr(gw->portPixMap);	rowBytes = (**gw->portPixMap).rowBytes & 0x3fff;	for (h=0; h<r.bottom; h++) {		long *pixelPtr = (long *)baseAddr;		for (w=0; w<r.right; w++, pixelPtr++) {			UInt8 r, g, b, a;			long pixel = *pixelPtr;			if ((pixel & 0x0ffffff) == 0x00ffffff)		// pure white				continue;			a = (pixel >> 24) & 0x0ff;			r = (pixel >> 16) & 0x0ff;			g = (pixel >>  8) & 0x0ff;			b = (pixel >>  0) & 0x0ff;			if ((r > kThreshold) && (g > kThreshold) && (b > kThreshold)) {				r = g = b = kThreshold;				*pixelPtr = (a << 24) | (kThreshold << 16) | (kThreshold << 8) | (kThreshold << 0);			}		}		baseAddr += rowBytes;	}	newPicture = OpenPicture(&r);	CopyBits((BitMap *)&gw->portPixMap, (BitMap *)&gw->portPixMap, &r, &r, ditherCopy, nil);	ClosePicture();bail:	if (gw)		DisposeGWorld(gw);	if (err == noErr) {		if (newPicture) {			KillPicture(*pic);			*pic = newPicture;		}	}	SetGWorld(savePort, saveGD);	return err;}