od ), noErr );  	FSMakeFSSpec( theSFReply.vRefNum, 0, theSFReply.fName, &mySpec );	err = FSpDelete ( &mySpec );	if ( err == fnfErr ) err = noErr;	BailOSErr( err );	FSpCreateResFile ( &mySpec, 'RSED', 'rsrc', smCurrentScript );	BailOSErr( ResError() );	resRefNum = FSpOpenResFile ( &mySpec, fsRdWrPerm );	BailOSErr( ResError() );	BailOSErr( AddSpriteControl( 128, resRefNum ) );bail:	if ( resRefNum ) 	CloseResFile ( resRefNum );}OSErr AddSpriteControl( short acurID, short resRefNum ){	OSErr 					err = noErr;	AcurRsrcHandle			acur = nil;	short					imageCount;	short					imageIndex;	RGBColor				keyColor;	Str255					name;	QTAtomContainer			sample = nil;		keyColor.red = keyColor.green = keyColor.blue = 0xFFFF;		// white	// create an empty key frame sample	BailOSErr( QTNewAtomContainer( &sample ) );	// get the list of image resource ids	acur = (AcurRsrcHandle) GetResource( 'acur', acurID );	if (!acur) BailOSErr( ResError() );	{		short theID;		ResType theType;		GetResInfo( (Handle) acur, &theID, &theType, name );		BailOSErr( ResError() );	}	// add images to the key frame sample	imageCount = (*acur)->noOfCursors;	for ( imageIndex = 0; imageIndex < imageCount; ++imageIndex )	{		short resID = (*acur)->cursors[imageIndex].rsrcId;		BailOSErr( AddPICTImageToKeyFrameSample( sample, resID, &keyColor, 0 ) );	}		// save the images as a resource	{		short saveResFile;		OSErr addResourceErr = noErr;		saveResFile = CurResFile();		UseResFile( resRefNum );		AddResource( sample, 'sprt', acurID, name );		addResourceErr = ResError();		sample = nil;	// now owned by rsrc mgr		UseResFile( resRefNum );		BailOSErr( addResourceErr );		BailOSErr( ResError() );	}	bail:	if ( sample )			QTDisposeAtomContainer( sample );	if ( acur )				ReleaseResource( (Handle) acur );	return err;}