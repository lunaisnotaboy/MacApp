#include "windows.h"#define cProcedureViews		1001#define cTemplateViews		1002#define cMonthlyDialog		1003#define cSaveDialog			1004#define cModalBeepDialog	1005#define cPageSetupDialog	1006#define cHomeBrewControls	1007#define cTabbingTest		1008#define cCalculator			1009#define cScrollingTest		1011#define cFormatDialog		1012#define cModelessBeepDialog	1013#define cMessageWindoid		1014#define cBalloons			1015#define cAdornment			1016#define cViewInspector		1017#define cTargetInspector	1018DEMODIALOGS MENU DISCARDABLEBEGIN	POPUP "&File"	BEGIN		MENUITEM "&Close\tCtrl+W",             				cClose, GRAYED		MENUITEM "&Page Setup...",							cPageSetup, GRAYED		MENUITEM "&Print...\tCtrl+P",						cPrint, GRAYED		MENUITEM "Print One Copy",							cPrintOne, GRAYED		MENUITEM SEPARATOR		MENUITEM "&Quit\tCtrl+Q",               			cQuit	END	POPUP "&Edit"	BEGIN		MENUITEM "&Undo\tCtrl+Z",               			cUndo, GRAYED		MENUITEM "&Redo\tCtrl+Shift+Z",               		cRedo, GRAYED		MENUITEM SEPARATOR		MENUITEM "Cu&t\tCtrl+X",                			cCut, GRAYED		MENUITEM "&Copy\tCtrl+C",               			cCopy, GRAYED		MENUITEM "&Paste\tCtrl+V",              			cPaste, GRAYED		MENUITEM "&Clear\tDel",                				cClear, GRAYED		MENUITEM "Select &All\tCtrl+A",         			cSelectAll, GRAYED		MENUITEM SEPARATOR		MENUITEM "Show Clipboard",		         			cShowClipboard, GRAYED	END	POPUP "&Dialogs"	BEGIN		MENUITEM "Views by Procedures",						cProcedureViews, GRAYED		MENUITEM "Views by Templates",						cTemplateViews, GRAYED		MENUITEM "Side-by-Side Scrolling",					cScrollingTest, GRAYED		MENUITEM "Monthly Values Dialog",					cMonthlyDialog, GRAYED		MENUITEM "Save Dialog",								cSaveDialog, GRAYED		MENUITEM "Modal Beep Dialog",						cModalBeepDialog, GRAYED		MENUITEM "Modeless Beep Dialog",					cModelessBeepDialog, GRAYED		MENUITEM "Message Windoid",							cMessageWindoid, GRAYED		MENUITEM "Cursors and Balloon Help",				cBalloons, GRAYED		MENUITEM "Adorners",								cAdornment, GRAYED		MENUITEM "Page Setup Dialog",						cPageSetupDialog, GRAYED		MENUITEM "Format Dialog",							cFormatDialog, GRAYED		MENUITEM "Home Brew Controls",						cHomeBrewControls, GRAYED		MENUITEM "Tabbing Test",							cTabbingTest, GRAYED		MENUITEM "Calculator",								cCalculator, GRAYED		MENUITEM "View Inspector",							cViewInspector, GRAYED		MENUITEM "Target Inspector",						cTargetInspector, GRAYED	END	POPUP "&Window"	BEGIN        MENUITEM "&Tile",                       			cTileWindows, GRAYED        MENUITEM "&Cascade",								cCascadeWindows, GRAYED        MENUITEM "Arrange &Icons",             				cArrangeIcons, GRAYED        MENUITEM "Close &All",                  			cCloseAll, GRAYED	END#if qDebug	POPUP "&Debug"	BEGIN		MENUITEM "Do First Click For This Window",			cDoFirstClick, GRAYED		MENUITEM "Refresh Front Window\tCtrl+R",          	cRefreshFrontWindow, GRAYED		MENUITEM SEPARATOR		MENUITEM "Show Debug Flags Window",         		cDebugFlags, GRAYED	END#endif	POPUP "&Help"	BEGIN		MENUITEM "&About Demo Dialogs...",			cAboutApp, GRAYED	ENDENDDEMODIALOGS ACCELERATORS MOVEABLE PURE BEGIN    "A",			cSelectAll,			VIRTKEY, CONTROL    "C",			cCopy,				VIRTKEY, CONTROL    "Q",			cQuit,				VIRTKEY, CONTROL    "P",			cPrint, 			VIRTKEY, CONTROL#if qDebug    "R",			cRefreshFrontWindow,VIRTKEY, CONTROL#endif    "V",			cPaste,          	VIRTKEY, CONTROL    "W",			cClose,				VIRTKEY, CONTROL    "X",			cCut,				VIRTKEY, CONTROL    "Z",			cUndo,				VIRTKEY, CONTROL    "Z",			cRedo,				VIRTKEY, CONTROL, SHIFTENDSTRINGTABLE DISCARDABLE BEGIN    kAppName             "DemoDialogs"    kDocName             "DemoDialogsDoc"END