#include "windows.h"#define cCommandHandledByApplication	400#define cCommandHandledByDocument		401#define cCommandHandledByView			402SKELETON MENU DISCARDABLEBEGIN	POPUP "&File"	BEGIN		MENUITEM "&New\tCtrl+N",            				cNew, GRAYED		MENUITEM "&Open...\tCtrl+O",            			cOpen, GRAYED		MENUITEM SEPARATOR		MENUITEM "&Close\tCtrl+W",             				cClose, GRAYED		MENUITEM "&Save\tCtrl+S",              				cSave, GRAYED		MENUITEM "Save &As",								cSaveAs, GRAYED		MENUITEM "&Revert",									cRevert, GRAYED		MENUITEM SEPARATOR		MENUITEM "&Page Setup...",							cPageSetup, GRAYED		MENUITEM "&Print...\tCtrl+P",						cPrint, GRAYED		MENUITEM "Print One Copy",							cPrintOne, GRAYED		MENUITEM SEPARATOR		MENUITEM "&Quit\tCtrl+Q",               			cQuit	END	POPUP "&Edit"	BEGIN		MENUITEM "&Undo\tCtrl+Z",               			cUndo, GRAYED		MENUITEM "&Redo\tCtrl+Shift+Z",               		cRedo, GRAYED		MENUITEM SEPARATOR		MENUITEM "Cu&t\tCtrl+X",                			cCut, GRAYED		MENUITEM "&Copy\tCtrl+C",               			cCopy, GRAYED		MENUITEM "&Paste\tCtrl+V",              			cPaste, GRAYED		MENUITEM "&Clear\tDel",                				cClear, GRAYED		MENUITEM "Select &All\tCtrl+A",         			cSelectAll, GRAYED		MENUITEM SEPARATOR		MENUITEM "Show Clipboard",		         			cShowClipboard, GRAYED	END	POPUP "&SkeletonMenu"	BEGIN		MENUITEM "Command Handled By &Application",			cCommandHandledByApplication, GRAYED		MENUITEM "Command Handled By &Document",			cCommandHandledByDocument, GRAYED		MENUITEM "Command Handled By &View",				cCommandHandledByView, GRAYED	END	POPUP "&Window"	BEGIN        MENUITEM "&Tile",                       			cTileWindows, GRAYED        MENUITEM "&Cascade",								cCascadeWindows, GRAYED        MENUITEM "Arrange &Icons",             				cArrangeIcons, GRAYED        MENUITEM "Close &All",                  			cCloseAll, GRAYED	END#if qDebug	POPUP "&Debug"	BEGIN		MENUITEM "Do First Click For This Window",			cDoFirstClick, GRAYED		MENUITEM "Refresh Front Window\tCtrl+R",          	cRefreshFrontWindow, GRAYED		MENUITEM SEPARATOR		MENUITEM "Show Debug Flags Window",         		cDebugFlags, GRAYED	END#endif	POPUP "&Help"	BEGIN		MENUITEM "&About Skeleton...",			cAboutApp, GRAYED	ENDENDSKELETON ACCELERATORS MOVEABLE PURE BEGIN    "A",			cSelectAll,			VIRTKEY, CONTROL    "C",			cCopy,				VIRTKEY, CONTROL    "N",			cNew,				VIRTKEY, CONTROL    "O",			cOpen,				VIRTKEY, CONTROL    "Q",			cQuit,				VIRTKEY, CONTROL    "P",			cPrint, 			VIRTKEY, CONTROL#if qDebug    "R",			cRefreshFrontWindow,VIRTKEY, CONTROL#endif    "S",			cSave,				VIRTKEY, CONTROL    "V",			cPaste,          	VIRTKEY, CONTROL    "W",			cClose,				VIRTKEY, CONTROL    "X",			cCut,				VIRTKEY, CONTROL    "Z",			cUndo,				VIRTKEY, CONTROL    "Z",			cRedo,				VIRTKEY, CONTROL, SHIFTENDSTRINGTABLE DISCARDABLE BEGIN    kAppName             "Skeleton"    kDocName             "SkeletonDoc"END