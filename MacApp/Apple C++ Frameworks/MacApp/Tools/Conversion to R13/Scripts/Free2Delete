"	find /virtual ~/∆:/T([A-Za-z0-9_])+/ "{1}"	set ClassName "`Catenate "{1}".§`"	find • "{2}"	find /•[ ∂t]*{ClassName}[ ∂t]*::[ ∂t]*~{ClassName}[ ∂t]*'('/ "{2}"	if {status}		find /•[ ∂t]*{ClassName}[ ∂t]*::[ ∂t]*{ClassName}[ ∂t]*'('/ "{2}"		if {status}			find /{ClassName}[ ∂t]*::/ "{2}"		end		find /•'}'≈∂n/∆ "{2}"		replace § ""∂n"//----------------------------------------------------------------------------------------"∂n"// {ClassName} destructor"∂n"//----------------------------------------------------------------------------------------"∂n"#pragma segment MADestructorRes"∂n""∂n"{ClassName}::~{ClassName}()"∂n"∂{"∂n"∂}∂n" "{2}"	endendfind • "{1}"find • "{2}"