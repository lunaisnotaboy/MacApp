#  UpdateClassInfo#  Copyright © 1997-1999 by Apple Computer, Inc.  All rights reserved.#+#	Change History#		03/24/99	Update copyright notice.#-Set Echo 0Set Exit 0beginfor f in {"parameters"}		target "{f}"		find •; find /•'DeclareClassDesc('≈');'[ ∂t∂n]+/	if !{status}		find •; replace -c ∞ /•'DeclareClassDesc('≈');'[ ∂t∂n]+/ ""	end	find •; find /'DeclareClassDesc'/	if !{status}		echo; echo "### could not remove 'DeclareClassDesc' in ∂"{f}∂""		search 'DeclareClassDesc' "{f}"	end		find •; find /•([ ∂t]+)®1'DeclareClass('≈');'/	if !{status}		find •; replace -c ∞ /•([ ∂t]+)®1'DeclareClass('≈');'/ "®1MA_DECLARE_CLASS;"	end	find •; find /'DeclareClass'/	if !{status}		echo; echo "### could not update 'DeclareClass' to 'MA_DECLARE_CLASS' in ∂"{f}∂""		search 'DeclareClass' "{f}"	end		find •; find /•([ ∂t]*)®1'DefineClass('(≈)®2');'/	if !{status}		find •; replace -c ∞ /•([ ∂t]*)®1'DefineClass('(≈)®2');'/ "®1MA_DEFINE_CLASS(®2);"	end	find •; find /'DefineClass'/	if !{status}		echo; echo "### could not update 'DefineClass' to 'MA_DEFINE_CLASS' in ∂"{f}∂""		search 'DefineClass' "{f}"	end		find •; find /•([ ∂t]*)®1'RegisterStdType("'(≈)®2'", '(≈)®3');'/	if !{status}		find •; replace -c ∞ /•([ ∂t]*)®1'RegisterStdType("'(≈)®2'", '(≈)®3');'/ "®1MA_REGISTER_SIGNATURE(®2, ®3);"	end	find •; find /'RegisterStdType'/	if !{status}		echo; echo "### could not update 'RegisterStdType' to 'MA_REGISTER_SIGNATURE' in ∂"{f}∂""		search 'RegisterStdType' "{f}"	end		find •; find /•([ ∂t]*)®1'macroDontDeadStrip('/	if !{status}		find •; replace -c ∞ /•([ ∂t]*)®1'macroDontDeadStrip('/ "®1MA_REGISTER_CLASS("	end	find •; find /'macroDontDeadStrip'/	if !{status}		echo; echo "### could not update 'macroDontDeadStrip' to 'MA_REGISTER_CLASS' in ∂"{f}∂""		search 'macroDontDeadStrip' "{f}"	end		find •; close -y "{target}"endend ∑∑ "{Worksheet}"