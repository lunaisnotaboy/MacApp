# ConvertFailInfo#  Copyright © 1997-1999 by Apple Computer, Inc.  All rights reserved.##	MPW Shell script to convert MacApp FailInfo handlers to the#	new TRY macros that are compatible with exception handling.#+#	Change History#		03/24/99	Update copyright notice.#-set exit 0find *loop	find /'FailInfo fi;'/	break if {status}	replace § '//Converted fi;'	replace /'Try'[ ∂t]*'('[ ∂t]*'fi'[ ∂t]*')'/ TRY	find /'{'/	matchit	find /[¬ ∂t∂n]+/	set it "`catenate §`"	if "{it}" == "else"		replace § "CATCH_ALL"	end	replace \'fi.Success'\ "//Success"	find /'{'/	matchit	find \*[ ∂t]*\	set it "`catenate §`"	replace /∂n/ "∂n{it}ENDTRY∂n"	replace \'fi.ReSignal'[ ∂t]*'()'\ THROWend# End of ConvertFailInfo