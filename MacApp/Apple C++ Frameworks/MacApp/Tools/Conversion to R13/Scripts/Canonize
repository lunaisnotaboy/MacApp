# Canonize#  Copyright © 1997-1999 by Apple Computer, Inc.  All rights reserved.##	Run Canon on a set of files#+#	Change History#		03/24/99	Update copyright notice.#-if ({#} < 2)	echo "Usage: {0} dict" source...	exitendSet Exit 0Set	dict	"{1}"ShiftOpen -h -n Canonize.tempFor	source in {"Parameters"}	If "`Exists -f "{source}"`"		Canon -s "{dict}" "{source}" > Canonize.temp		Equal -q -d "{source}" Canonize.temp		If {Status}			Echo "Modifying:    {source}"			ModifyReadOnly "{source}"			Duplicate -d -y Canonize.temp "{source}"		End	EndEndClose -n Canonize.temp# End of Canonize