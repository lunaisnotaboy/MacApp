#  RunSearch#  Copyright © 1997-1999 by Apple Computer, Inc.  All rights reserved.# Perform a search for expression {1} in all files recursively in {3}# if there are any matches, the output suggests changing {1} with {2}# listing the files and lines from {3} where {1} was found.#+#	Change History#		03/24/99	Update copyright notice.#-set exit 0search /{1}/ `files -o -f  -r -t TEXT "{3}"` > tempif `count -l "temp"`	Echo "# For each occurrence of: {1}"	Echo "#           Replace with: {2}"	catenate tempendset exit 1