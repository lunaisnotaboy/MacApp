# RunCanon#  Copyright © 1997-1999 by Apple Computer, Inc.  All rights reserved.## Run Canon over a folder's contents, recursively over contained folders## Works on C (.cp, .cpp, .cxx, .c, .h) source code. Plus all text files!## TBD: Add a command option to turn on/off the Compare facility#+#	Change History#		03/24/99	Update copyright notice.#-if ({#} < 2)	echo "Usage: {0} dict directory..."	exitendSet Exit 0Set	dict	"{1}"ShiftFor sources in {"parameters"}	Canonize "{dict}" `Files -f -r -s -t TEXT "{sources}"`	UpdateClassInfo `Files -f -r -s -t TEXT "{sources}"`End{MADone}# End of RunCanon