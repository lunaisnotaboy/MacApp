# IConstructAll#  Copyright © 1997-1999 by Apple Computer, Inc.  All rights reserved.##	Runs IConstructor for all the .h and .cp+ files in a list of folders.#	Assumes the .h and .cp+ files are either in the same folder or#	in sibling :Includes: and :Sources: folders. Creates an IConstructor.dict#	file that can be used with Canon to rename IMethod calls.##		IConstructAll directory...#+#	Change History#		03/24/99	Update copyright notice.#-if ¬"{IConstructor$dict}"	set -e IConstructor$dict IConstructor.dictendopen -n "{IConstructor$dict}"begin	for d in {"parameters"}		for f in `files -t TEXT "{d}"`			if "{f}" =~ /(≈)®1.h/				set cp "{d}{®1}.cpp"				if "`exists -f "{cp}"`" != ""					IConstructor "{d}{f}" "{cp}"				else					set cp "{d}{®1}.cp"					if "`exists -f "{cp}"`" != ""						IConstructor "{d}{f}" "{cp}"					else						set cp "{d}:Sources:{®1}.cpp"						if "`exists -f "{cp}"`" != ""							IConstructor "{d}{f}" "{cp}"						else							set cp "{d}:Sources:{®1}.cp"							if "`exists -f "{cp}"`" != ""								IConstructor "{d}{f}" "{cp}"							else								IConstructor "{d}{f}"							end						end					end				end			else if "{f}" =~ /(≈)®1.cp+/				set h "{d}{®1}.h"				if "`exists -f "{h}"`" != ""					IConstructor "{h}" "{d}{f}"				else					set h "{d}:Includes:{®1}.h"					if "`exists -f "{h}"`" != ""						IConstructor "{h}" "{d}{f}"					else						IConstructor "{d}{f}"					end				end			end		end	endend >>"{IConstructor$dict}"sort "{IConstructor$dict}" -f 1r,2r -unique -o "{IConstructor$dict}"{MADone}# End of IConstructAll