# IConstructor#  Copyright © 1997-1999 by Apple Computer, Inc.  All rights reserved.##	Renames IMethods to constructors in a pair of .h and .cp+ files.#	Echoes IMethod constructor records for each IMethod that is renamed.#	Normally this is piped into a dictionary file that can be used with#	Canon to rename IMethod calls. See IConstructAll (or just use it) for#	an example.##	IConstructor only renames the IMethods. You will have to do some editing#	by hand before the new constructors will compile. This gives you a chance#	to eliminate unnecessary constructors, add default mem-initializers and#	whatever else is needed to make the new constructors correct.##		IConstructor header source#+#	Change History#		03/24/99	Update copyright notice.#-set exit 0if "{2}" != ""	open -h "{2}"	find ¥ "{2}"endopen -h "{1}"find ¥ "{1}"loop	# Find a class declaration	find /¥[ ¶t]¥class[ ¶t¶n]+[A-Za-z0-9]+[ ¶t¶n]¥[:¶/]/ "{1}"	break if {status}	# Get the class name	find Æ¤ "{1}"	find /[ ¶t]¥class[ ¶t¶n]+/Æ:/[A-Za-z0-9]+/ "{1}"	set ClassName "`Catenate "{1}".¤`"	if "{ClassName}" =~ /T(Å)¨1/		# Find the IMethod		set IMethod "I{¨1}"		find /[ ¶t¶n]¥void[ ¶t¶n]+{IMethod}[ ¶t¶n]¥¶(/ "{1}"		continue if {status}		echo "{IMethod}¶t{ClassName}"		# Convert IMethod declarations to constructors		modifyreadonly "{1}"		find Æ¤ "{1}"		replace -c ° /([ ¶t¶n]+)¨1void[ ¶t¶n]+{IMethod}([¶t¶n]¥)¨2¶(/ "¨1{ClassName}¨2(" "{1}"		# Convert IMethod implementations to constructors		mark -y ¤ $IConstructor$temp$ "{1}"		find ¥ "{1}"		replace -c ° /¥([ ¶t]¥)¨1void[ ¶t¶n]+{ClassName}([¶t¶n]¥::[ ¶t¶n]¥)¨3{IMethod}([ ¶t¶n]¥)¨2¶(/ "¨1{ClassName}¨3{ClassName}¨2(" "{1}"		find $IConstructor$temp$ "{1}"		unmark $IConstructor$temp$ "{1}"		if "{2}" != ""			find ¥ "{2}"			find /¥([ ¶t]¥)¨1void[ ¶t¶n]+{ClassName}([¶t¶n]¥::[ ¶t¶n]¥)¨3{IMethod}([ ¶t¶n]¥)¨2¶(/ "{2}"			continue if {status}			modifyreadonly "{2}"			find Æ¤ "{2}"			replace -c ° /¥([ ¶t]¥)¨1void[ ¶t¶n]+{ClassName}([¶t¶n]¥::[ ¶t¶n]¥)¨3{IMethod}([ ¶t¶n]¥)¨2¶(/ "¨1{ClassName}¨3{ClassName}¨2(" "{2}"		end	endendfind ¥ "{1}"close -y "{1}"if "{2}" != ""	find ¥ "{2}"	close -y "{2}"end# End of IConstructor