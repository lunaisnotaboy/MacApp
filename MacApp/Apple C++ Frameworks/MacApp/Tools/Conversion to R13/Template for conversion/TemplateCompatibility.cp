To(vRt);}bool SectVRect(const VRect& src1,				  const VRect& src2,				  VRect& dst){	dst = src1 & src2;	return !dst.Empty();}void UnionVRect(const VRect& src1,				const VRect& src2,				VRect& dst){	dst = src1 | src2;}#endif // MACAPP_R_13MA_DEFINE_CLASS(TObject);//----------------------------------------------------------------------------------------// End of TemplateCompatibility.cp 