// ===========================================================================//	MyPP_DebugHeaders.pch++//  Copyright й 1999-2001 by Apple Computer, Inc., All Rights Reserved// ===========================================================================////	Source for precompiled header for PowerPlant headers////	This file #includes most header files for the PowerPlant library,//	as well as most of the Toolbox headers used by the PowerPlant library//	with all debugging symbols defined./*	Change History:		03/10/01	Suppress the PP 2.1 reminder notes. 		03/09/01	Integrate with ACS. */	// This same file works for PowerPC, CFM68K, and 68K. We check the target	// at compile time and specify the appropriate output file name.	#if __POWERPC__	#pragma precompile_target "MyPP_DebugHeadersPPC"	#elif __CFM68K__	#pragma precompile_target "MyPP_DebugHeadersCFM68K"	#else	#pragma precompile_target "MyPP_DebugHeaders68K"#endif#pragma once on#pragma check_header_flags on#define PP_Suppress_Notes_21	1// Turn on flags#define qCarbon 0#define qNeedsSystem8_5 0// ========================================================// еее BIG RED SWITCH FOR DEBUGGING еее// 0=nodebug, 1=debug (finer grain control can be found in CWMacAppSwitches.h)// ========================================================#if !defined(wantDebugging)#	define wantDebugging 1#endif#ifndef	MSL_USE_PRECOMPILED_HEADERS #define MSL_USE_PRECOMPILED_HEADERS	0	// We supply our own in ACS#endif // Set to 1 if you want to use precompiled ACS Headers#ifndef	qUSE_PRECOMPILED_HEADERS #define qUSE_PRECOMPILED_HEADERS    1#endif // Set to 1 if you are building a DLL or shared library.#ifndef	qExportSymbols_AC #define qExportSymbols_AC    1#endif // Switches that must be included before anything else#ifndef __ansi_prefix__#include <ansi_prefix.mac.h>#endif#ifndef __ConditionalMacros_AC__#include "ConditionalMacros_AC.h"#endif#ifndef __CoreSwitches_AC__#include "CoreSwitches_AC.h"#endif#ifndef __Debug_AC__#include "Debug_AC.h"#endif#ifndef _H_PP_Prefix#include <PP_Prefix.h>#endif// Headers optionally included for faster compilation#ifndef __ACSHeaders_AC__#include "ACSHeaders_AC.h"#endif#include <PP_DebugHeaders.cp>