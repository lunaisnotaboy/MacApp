/*	File:		CCounterApp.cp	Contains:	Sample code to accompany Chapter 12 of 				"An Introduction to Macintosh Programming for Windows Programmers".					Written by:	Worldwide Developer Technical Support	Copyright:	1999-2001 Apple Computer, Inc., All Rights Reserved  	You may incorporate this sample code into your applications without  	restriction, though the sample code has been provided "AS IS" and the  	responsibility for its operation is 100% yours.  However, what you are  	not permitted to do is to redistribute the source as "DSC Sample Code"  	after having made changes. If you're going to re-distribute the source, 	we require that you make it clear in the source that the code was    descended from Apple Sample Code, but that you've made changes.*//*	Change History:		03/14/01	[PB] Need to include classes to register. 		03/09/01	Updated to build with CW Pro 6 and PowerPlant 2.1. 							Make the application smaller by registering only the							classes used, and making the GA classes conditional. 							Use ACS TidyHeap for tracking object allocations. */#include <PP_Prefix.h>#ifndef PP_Target_Appearance#define PP_Target_Appearance 1#endif#include "CCounterApp.h"#include "CounterConstants.h"#include "CCounterDocument.h"#if !PP_TARGET_OS_MAC_OSX#include <LSIOUXAttachment.h>#endif#include <iostream.h>#include <LStaticText.h>#include <LIconPane.h>#if !PP_TARGET_OS_MAC_OSX#include <LActiveScroller.h>#endif#include <LGrowZone.h>#include <LWindow.h>#include <PP_Messages.h>#include <PP_Resources.h>#include <UDrawingState.h>#include <UMemoryMgr.h>#include <URegistrar.h>#include <UModalDialogs.h>#include <UStandardDialogs.h>#include <UControlRegistry.h>#include <UGraphicUtils.h>#include <UEnvironment.h>#include <LCmdBevelButton.h>#include <LWindowHeader.h>#include <LGADialog.h>#include <LAMBevelButtonImp.h>#include <LAMStaticTextImp.h>#include <LAMWindowHeaderImp.h>#if !PP_Target_Appearance#include <LGABevelButtonImp.h>#include <LGAStaticTextImp.h>#include <LGAWindowHeaderImp.h>#endif#include <LCaption.h>#include <LDialogBox.h>#include <LEditField.h>#include <LStdControl.h>#include <LPicture.h>#include <UDesktop.h>// ACS#ifndef __CTidyHeap_AC__#include "CTidyHeap_AC.h"#endif// Toolbox#ifndef __APPEARANCE__#include <Appearance.h>#endif#include <Sound.h>#include <ToolUtils.h>// ===========================================================================int main(){	SetDebugThrow_(debugAction_Alert);	SetDebugSignal_(debugAction_Alert);	InitializeHeap(3);					// allocate 3 Master Pointer blocks#if !PP_Target_Carbon	UQDGlobals::InitializeToolbox(&qd);#endif	UEnvironment::InitEnvironment();	TH_new LGrowZone(20000);			// For low memory situations.	CCounterApp	theApp;			// stack allocation	theApp.Run();	return 0;}// ---------------------------------------------------------------------------CCounterApp::CCounterApp(){	if ( UEnvironment::HasFeature( env_HasAppearance ) ) {		::RegisterAppearanceClient();	}	// Main window	RegisterClass_(LWindow);	RegisterClass_(LCaption);	RegisterClass_(LWindowHeader);	RegisterClass_(LStaticText);	RegisterClass_(LCmdBevelButton);	if (UEnvironment::HasFeature (env_HasAppearance)) {		RegisterClassID_(LAMWindowHeaderImp, LWindowHeader::imp_class_ID);		RegisterClassID_(LAMStaticTextImp, LStaticText::imp_class_ID);		RegisterClassID_(LAMBevelButtonImp, LBevelButton::imp_class_ID);#if !PP_Target_Appearance	} else {		RegisterClassID_(LGAWindowHeaderImp, LWindowHeader::imp_class_ID);		RegisterClassID_(LGAStaticTextImp, LStaticText::imp_class_ID);		RegisterClassID_(LGABevelButtonImp, LBevelButton::imp_class_ID);#endif	}	// Dialog	RegisterClass_(LDialogBox);	RegisterClass_(LEditField);	RegisterClass_(LStdButton);	// About Box	RegisterClass_(LPicture);	RegisterClass_(LGADialog);#if PP_TARGET_OS_MAC_OSX#else	RegisterClass_(LActiveScroller);#endif	// Application#if PP_TARGET_OS_MAC_OSX#else	AddAttachment(TH_new LSIOUXAttachment);	// Use SIOUX Attachment#endif}// ---------------------------------------------------------------------------CCounterApp::~CCounterApp(){}// ---------------------------------------------------------------------------//	This function lets you do something when the application starts up//	without a document.voidCCounterApp::StartUp(){	ObeyCommand(cmd_New, nil);}// ---------------------------------------------------------------------------------voidCCounterApp::OpenDocument(FSSpec* inMacFSSpec ){	LDocument* theDoc = LDocument::FindByFileSpec(*inMacFSSpec);	if (theDoc != nil) {				// Document is already open		theDoc->MakeCurrent();			// Make it the current document	} else {							// Make a new Document		theDoc = TH_new CCounterDocument(this, inMacFSSpec);	}}// ---------------------------------------------------------------------------------LModelObject*CCounterApp::MakeNewDocument(){	FSSpec* spec = nil;	return TH_new CCounterDocument(this, spec);}// ---------------------------------------------------------------------------------voidCCounterApp::ChooseDocument(){#if PP_Target_Carbon	PP_StandardDialogs::LFileChooser	chooser;			// Open any/all kDocType files		NavDialogOptions*	options = chooser.GetDialogOptions();	if (options != nil) {		options->dialogOptionFlags =	kNavDefaultNavDlogOptions										+ kNavSelectAllReadableItem;	}	if (chooser.AskOpenFile(LFileTypeList(kDocType))) {		AEDescList		docList;		chooser.GetFileDescList(docList);		SendAEOpenDocList(docList);	}#else	UDesktop::Deactivate();	SFTypeList			theTypeList = {kDocType};	StandardFileReply	theReply;	::StandardGetFile( nil, 1, theTypeList, &theReply );	UDesktop::Activate();	if (theReply.sfGood) {				// if not canceled		SendAEOpenDoc(theReply.sfFile);	// send AppleEvent to open the document	}#endif}// ---------------------------------------------------------------------------------voidCCounterApp::PrintDocument(FSSpec* inMacFSSpec ){	CCounterDocument* theDocument = TH_new CCounterDocument(this, inMacFSSpec);	theDocument->DoPrint();}// ---------------------------------------------------------------------------------voidCCounterApp::ShowAboutBox(){	UDesktop::Deactivate();		// Alert will swallow Deactivate event	StDialogHandler	theHandler(rAboutBox, this);	LWindow* theDialog = theHandler.GetDialog();		theDialog->Show();	while (true) {		MessageT hitMessage = theHandler.DoDialog();		if (hitMessage == msg_OK) {			break;		}	}	UDesktop::Activate();}