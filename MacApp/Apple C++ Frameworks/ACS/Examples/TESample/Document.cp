nil, &wdRefNum);	TApplication::WDToDirID(wdRefNum, fFile.vRefNum, fFile.dirID);	CopyPString(fFile.fileName,"\pUntitled");	fDocWindow = GetNewWindow(resID,nil,(WindowPtr) -1);	SetPort(fDocWindow);}TDocument::~TDocument(){	if (fFileRefNum != 0)		CloseFile();	DisposeWindow(fDocWindow);}void TDocument::DoActivate(bool becomingActive){	fActive = becomingActive;}void TDocument::OpenFile(bool readOnly, bool createIfNecessary){	// first, check if file exists	FInfo fndrInfo;	OSErr err = HGetFInfo(fFile.vRefNum,fFile.dirID,fFile.fileName,&fndrInfo);	if ((err == fnfErr) && createIfNecessary)	{		ThrowIfOSErr_AC(HCreate(fFile.vRefNum,fFile.dirID,fFile.fileName,								TApplication::GetCreator(),fFileType));	}	else ThrowIfOSErr_AC(err);	char perm = (readOnly) ? fsRdPerm : fsRdWrPerm;	ThrowIfOSErr_AC(HOpen(fFile.vRefNum, fFile.dirID,						  fFile.fileName, perm, &fFileRefNum));}void TDocument::CloseFile(){	if (fFileRefNum != 0)	{		ThrowIfOSErr_AC(FSClose(fFileRefNum));		fFileRefNum = 0;	}}void TDocument::OpenOldDoc(CanonicalFileSpec theFile, bool readOnly){	fFile = theFile;	fFileRefNum = 0;	fNewDoc = false;	fReadOnly = readOnly;	fDirty = false;	OpenFile(fReadOnly,false);	(void) SetFPos(fFileRefNum,fsFromStart,0);	ReadFromFile(fFileRefNum);	SetWTitle(fDocWindow,fFile.fileName);	SetPort(fDocWindow);}YNCResult TDocument::PresentSaveDialog(bool quitting){	SetCursor(&qd.arrow);	Str255 fileName;	CopyPString(fileName,fFile.fileName);	Str255 buzzword;	if (quitting)		GetIndString(buzzword,kBuzzwordStrings,bQuitting);	else		GetIndString(buzzword,kBuzzwordStrings,bClosing);	ParamText(fileName, buzzword, "\p", "\p");	short item = Alert(rSaveAlert, (ModalFilterUPP) nil);	switch (item)	{		case 1:		default:			return yesResult;		case 2:			return noResult;		case 3:			return cancelResult;	}}YNCResult TDocument::DoClose(bool askUserToSave, YNCResult defaultAnswer, bool quitting){	YNCResult res;	if (fDirty && askUserToSave)		res = PresentSaveDialog(quitting);	else		res = defaultAnswer;	if (fDirty && (res == yesResult))		DoSave();	return res;}void TDocument::DoSave(){	if (fNewDoc)	{		DoSaveAs();		return;	}	if (!fDirty)		return;	ThrowIfOSErr_AC(SetFPos(fFileRefNum,fsFromStart,0));	ThrowIfOSErr_AC(SetEOF(fFileRefNum,0));	WriteToFile(fFileRefNum);	fDirty = false;}void TDocument::DoSaveAs(){	CPoint_AC where(100,100);	Str255 origName;	CopyPString(origName,fFile.fileName);	Str255 prompt;	prompt[0] = '\0';	SFReply reply;	SFPutFile(where, prompt, origName, NULL, &reply);	if (reply.good == false)		return;	// close existing file, if any	if (fFileRefNum != 0)		CloseFile();	// setup fields correctly	TApplication::WDToDirID(reply.vRefNum, fFile.vRefNum, fFile.dirID);	CopyPString(fFile.fileName, reply.fName);	OpenFile(false,true);	SetWTitle(fDocWindow,fFile.fileName);	ThrowIfOSErr_AC(SetFPos(fFileRefNum,fsFromStart,0));	WriteToFile(fFileRefNum);	fNewDoc = false;	fDirty = false;}//---------------------------------------------------------------------------------// find the TDocument associated with the windowTDocument* TDocumentList::FindDoc(WindowPtr window) const{	for (const_iterator iter(begin()); iter != end(); ++iter)	{		if ((*iter)->GetDocWindow() == window)			return *iter;	}	return nil;}void TDocumentList::Delete(TDocument* doc){	iterator position = std::find(begin(), end(), doc);	if (position != end())		erase(position);}